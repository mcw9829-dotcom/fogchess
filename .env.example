# Names and safe local paths only. Do not put real credentials in this file.
# The Python entry points read process environment variables; .env is not auto-loaded.
# dev_server.py always selects .dev-data/fogchess-dev.db and FOG_DEV_PORT.
FOG_DEV_HOST=127.0.0.1
FOG_DEV_PORT=7556
FOG_DB=.dev-data/fogchess-dev.db
FOG_SECURITY_DB=.dev-data/security.sqlite3
FOG_REPLAY_DB=.dev-data/replays.sqlite3
# Set FOG_ADMIN_KEY privately in the server environment when admin access is needed.
# Set FLY_API_TOKEN in GitHub Actions secrets for a manual deployment.
