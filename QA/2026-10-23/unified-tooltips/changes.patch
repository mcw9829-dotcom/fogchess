+	var rect := Rect2i(tip.position-Vector2i(12,12),tip.size+Vector2i(24,60)).intersection(Rect2i(Vector2i.ZERO,root.size))
+	picture.get_region(rect).save_png(directory.path_join(label+"-detail.png"))
