extends SceneTree
var app: Control
var failures := 0
func _initialize() -> void: run.call_deferred()
func check(ok: bool, message: String) -> void:
	if ok: print("PASS: "+message)
	else: failures+=1; push_error(message)
func settle(seconds: float=.3) -> void: await create_timer(seconds).timeout
func capture(label: String) -> void:
	if "--capture" not in OS.get_cmdline_user_args(): return
	await settle()
	RenderingServer.force_draw(false)
	var folder := ProjectSettings.globalize_path("res://../.dev-data/queue-captures")
	DirAccess.make_dir_recursive_absolute(folder)
	root.get_texture().get_image().save_png(folder.path_join(label+".png"))
func visible_window() -> Window:
	for child in app.get_children():
		if child is Window and child.visible and not child.is_queued_for_deletion(): return child
	return null
func close_windows() -> void:
	for child in app.get_children():
		if child is Window: child.hide(); child.queue_free()
	await settle()
func opponent(command: String) -> Dictionary:
	return await app.api.request("/match/"+command,{"session":"b"})
func run() -> void:
	root.size=Vector2i(1280,900)
	app=load("res://main(게임 시작 씬).tscn").instantiate()
	root.add_child(app)
	await settle()
	app.audio.enabled=false
	app.session="a"
	app.me={"name":"플레이어","rating":1000,"tier":"N"}
	await app._match_command("join")
	app.ui_shell.lobby_home.select_section("computer",false)
	check(app.ui_shell.lobby_home.selected=="computer","accordion remains interactive while queued")
	check(not app.ui_shell.lobby_home.level_buttons[0].disabled,"computer difficulty buttons enabled")
	await capture("lobby-queue")
	root.size=Vector2i(390,844)
	app._layout()
	await settle(.6)
	await capture("mobile-lobby-queue")
	root.size=Vector2i(1280,900)
	app._layout()
	app._settings()
	check(app.subpage.visible,"settings opens while queued")
	await settle(9)
	var status: Dictionary=await app.api.request("/match/status",{"session":"a"})
	check(status.get("state")=="waiting" and int(status.get("waited",0))>=8,"modal keeps queue heartbeat beyond stale timeout")
	await capture("settings-queue")
	await opponent("join")
	await settle(1.2)
	check(is_instance_valid(app.match_window) and app.match_window.visible,"found popup appears over settings")
	check(app.subpage.visible,"settings remains behind match acceptance popup")
	await app._match_command("cancel")
	await settle()
	check(app.subpage.visible and not app.matching,"declining returns to settings")
	await opponent("cancel")
	await close_windows()
	app._navigation_home()
	await app._match_command("join")
	app._help()
	var guide: Window=visible_window()
	check(is_instance_valid(guide) and guide.name=="PieceGuide","piece guide opens while queued")
	await opponent("join")
	await settle(1.2)
	await app._match_command("cancel")
	await settle()
	check(guide.visible,"declining restores piece guide without resetting it")
	await opponent("cancel")
	await close_windows()
	await app._match_command("join")
	app._tutorial()
	check(is_instance_valid(visible_window()) and visible_window().title.contains("왕 찾기"),"interactive tutorial opens while queued")
	await capture("tutorial-queue")
	var tutorial_window: Window=visible_window()
	await opponent("join")
	await settle(1)
	await app._match_command("cancel")
	await settle()
	check(tutorial_window.visible,"declining restores interactive tutorial")
	await opponent("cancel")
	await close_windows()
	await app._match_command("join")
	await app._join({"solo":true})
	await settle(2)
	check(app.matching and app.view.get("solo",false) and app.view.get("queuePractice",false),"solo practice also preserves queue")
	app._leave_prompt()
	var leave_window: Window=visible_window()
	for button in leave_window.find_children("*","Button",true,false):
		if button.text=="나가기": button.pressed.emit(); break
	await settle(2)
	check(app.room.is_empty() and app.matching,"leaving practice returns to lobby without cancelling queue")
	await app._join({"vs_bot":true,"level":"easy"})
	await settle(2.3)
	check(app.matching and app.view.get("queuePractice",false) and app.view.get("bot",false),"bot practice runs while queue continues")
	check(not app.view.get("rated",true),"waiting practice is unrated")
	check(app.lobby_status.queue_card.visible,"queue status remains visible during practice")
	var warmup: String=app.room
	await app._act({"type":"ready"})
	await settle(1)
	check(app.view.get("phase")=="play","practice action and state polling both work")
	await capture("practice-queue")
	root.size=Vector2i(390,844)
	app._layout()
	await settle(.7)
	await capture("mobile-practice-queue")
	check(app.lobby_status.queue_card.get_global_rect().end.x<=app.size.x+1,"mobile queue banner fits viewport")
	await settle(8.2)
	status=await app.api.request("/match/status",{"session":"a"})
	check(status.get("state")=="waiting","practice keeps queue heartbeat beyond stale timeout")
	await opponent("join")
	await settle(1.1)
	check(is_instance_valid(app.match_window) and app.match_window.visible,"match found popup appears over practice")
	await capture("mobile-found")
	root.size=Vector2i(1280,900)
	app._layout()
	app.match_window.popup_centered(Vector2i(380,500))
	await settle()
	await capture("practice-found")
	await app._match_command("accept")
	check(app.room==warmup and app.matching,"single acceptance does not end practice")
	await opponent("decline")
	await settle(1)
	check(app.room==warmup and app.match_data.get("state")=="waiting","opponent decline resumes searching and preserves practice")
	await opponent("join")
	await settle(1)
	await app._match_command("accept")
	var paired: Dictionary=await opponent("accept")
	await settle(1.8)
	check(paired.get("state")=="matched" and app.room==str(paired.get("room")),"both accept enters the same ranked room")
	check(not app.matching and app.view.get("match",false) and not app.view.get("queuePractice",true),"ranked state replaces practice cleanly")
	check(not app.lobby_status.queue_card.visible and not is_instance_valid(app.match_window),"queue banner and popup close on entry")
	var snapshot: Dictionary=await app.api.request("/test-queue",{})
	check(not warmup in snapshot.get("rooms",[]),"server retires previous practice room")
	await capture("rank-entered")
	print("QUEUE_ACTIVITIES_FAILURES=%d" % failures)
	app.queue_free();await process_frame;quit(1 if failures else 0)
